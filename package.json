{
  "name": "god-v-forme",
  "version": "1.0.1",
  "private": true,
  "description": "Мой год в форме — личный PWA-трекер питания, тренировок и прогресса для iPad и iPhone",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:single": "node scripts/build.mjs --single",
    "preview": "node scripts/serve.mjs dist 4173",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "node scripts/build.mjs && node e2e/smoke.mjs",
    "figures": "node tools/preview/render-figures.mjs",
    "icons": "node tools/make-icons.mjs",
    "typecheck:local": "tsc --noEmit -p tsconfig.check.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "seed": "python3 tools/build_seed.py"
  },
  "dependencies": {
    "jszip": "3.10.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
